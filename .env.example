# Copy this file to .env and fill the values. Never commit .env.

# Timezone for all date logic and emails. Timestamps are stored in UTC.
TZ=Asia/Kathmandu

# Mounted data folder: the SQLite file, profile PDFs, criteria, and secrets live here.
DATA_DIR=/data

# --- Gmail (run `jobbot setup-gmail` on your Mac, then copy the token to the VM) ---
# Path to the Google OAuth client JSON from your Google Cloud project.
GOOGLE_OAUTH_CLIENT_FILE=/data/secrets/client_secret.json
# Where the token from `jobbot setup-gmail` is read from.
GMAIL_TOKEN_FILE=/data/secrets/gmail_token.json
# Where alert and notification emails go. Defaults to the authenticated Gmail address.
ALERT_EMAIL_TO=
# How many days back to read LinkedIn emails, and the sender addresses. Verify the
# senders against real emails in your inbox (spec 0001 follow-up).
GMAIL_LOOKBACK_DAYS=15
LINKEDIN_ALERT_SENDERS=jobalerts-noreply@linkedin.com,jobs-listings@linkedin.com
LINKEDIN_NOTIFICATION_SENDER=notifications-noreply@linkedin.com

# --- Backup alerts (used only when Gmail sending fails) ---
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# --- AI parsing (Ollama first, then paid providers as fallback) ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_RESIDENT_MODELS=qwen2.5:3b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
XAI_API_KEY=
GROK_MODEL=grok-build-0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_OLLAMA_TIMEOUT_SECONDS=30
AI_HOSTED_TIMEOUT_SECONDS=20
AI_HOSTED_DAILY_CAP=200

# --- Web search ---
SEARXNG_URL=http://searxng:8080
BRAVE_API_KEY=
BRAVE_MONTHLY_CAP=950
SEARCH_QUERIES_PER_HOUR=2

# --- Criteria sources ---
GITHUB_USERNAME=
GITHUB_TOKEN=
NEPAL_LIST_URL=https://raw.githubusercontent.com/mesaugat/tech-companies-in-nepal/master/README.md

# --- Retention ---
MAX_JOB_AGE_DAYS=14
RETENTION_DAYS=30
